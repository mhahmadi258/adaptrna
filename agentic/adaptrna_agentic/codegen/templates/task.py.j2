        data = cfg["data"]
        return CsvDataModule(
            data_root=data["root"],
            val_root=data.get("val_root"),
            alphabet=Alphabet(),
            batch_size=data.get("batch_size", 32),
            num_workers=data.get("num_workers", 0),
        )
